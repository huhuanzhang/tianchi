{
  "base_model": "models/lingbot-vla-v2-6b",
  "vlm_config": "models/Qwen3-VL-4B-Instruct-config",
  "dataset_root": "data/RoboTwin_lerobot_v21",
  "split": "augmentation/artifacts/split.json",
  "augment_config": "augmentation/configs/color_crop_joint_dropout.json",
  "augment_stats": "augmentation/artifacts/train_stats.json",
  "norm_stats": "training/artifacts/clean_train_norm.json",
  "output": "outputs/rtc_fresh",
  "micro_batch_size": 8,
  "global_batch_size": 64,
  "learning_rate": 2e-05,
  "min_learning_rate": 2e-06,
  "warmup_steps": 1000,
  "weight_decay": 0.01,
  "chunk_size": 50,
  "image_size": 224,
  "seed": 532514,
  "action_dtype": "float32",
  "num_train_epochs": 10,
  "max_steps": null,
  "save_steps": 8000,
  "keep_checkpoints": 10,
  "validation_steps": 1000,
  "validation_batches": 64,
  "num_workers": 8,
  "episode_cache_size": 2,
  "torch_threads": 2,
  "checkpoint_gradient": true,
  "export_full": true,
  "rtc": {
    "enabled": true,
    "method": "action_prefix_v1",
    "max_delay": 12,
    "zero_delay_probability": 0.3,
    "execute_steps": 25
  },
  "pin_memory": false,
  "action_expert_dropout": {
    "attention_output_probability": 0.2,
    "ffn_output_probability": 0.2,
    "state_feature_probability": 0.0
  }
}
